# SkillOpt 环境变量模板
# 复制为 .env 并填入你的 API key
# cp .env.template .env

# === Optimizer（评分反思模型）= DeepSeek Chat ===
export OPTIMIZER_BACKEND=openai_compatible
export OPTIMIZER_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
export OPTIMIZER_OPENAI_COMPATIBLE_API_KEY=sk-xxx
export OPTIMIZER_OPENAI_COMPATIBLE_MODEL=deepseek-chat

# === Target（被训练执行任务）= Qwen Flash（阿里云 DashScope）===
export TARGET_BACKEND=openai_compatible
export TARGET_OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export TARGET_OPENAI_COMPATIBLE_API_KEY=sk-xxx
export TARGET_OPENAI_COMPATIBLE_MODEL=qwen-flash
