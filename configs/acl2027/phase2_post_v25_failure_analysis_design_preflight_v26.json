    "fresh_explicit_provider_authorization_required": true
  },
  "decision_rules": {
    "primary": "paired contextual_typed_prior minus global_only accuracy on 400 new tasks under both strict and alias-tolerant scoring",
    "positive": "strict_margin >= 0.05 and alias_margin >= 0.05 and strict_wins - strict_losses >= 20 and alias_wins - alias_losses >= 20 and at least 4 of 5 alias family margins are nonnegative and mechanism_stratum_n >= 20 and typed_recovery_minus_copied_global >= 0.10",
    "negative": "(alias_margin <= 0 and alias_wins <= alias_losses) or (strict_margin <= -0.025 and alias_margin <= -0.025)",
    "otherwise": "inconclusive",
    "insufficient_mechanism_stratum": "inconclusive",
    "v23_v25_results_remain_descriptive_inputs_only": true
  },
