  "design": {
    "target_families": [
      "attribute_comparison",
      "bridge_attribute_comparison"
    ],
    "tasks_per_family": 20,
    "tasks": 40,
    "conditions": [
      "cold",
      "global_only",
      "contextual_single",
      "irrelevant_single",
      "dual_contextual_first",
      "dual_irrelevant_first"
    ],
    "logical_calls": 240,
    "selection": "20 lowest SHA256(phase3d-v1:specificity-abstention:<family>:<task_id>) unused task IDs per target family",
    "selection_must_be_gold_independent": true,
    "new_task_ids_required": true,
    "irrelevant_family_map": {
      "attribute_comparison": "bridge_attribute_comparison",
      "bridge_attribute_comparison": "entity_bridge"
    },
    "dual_order_control": true
  },
  "response_contract": {
    "exact_keys": [
      "skill_assessments",
      "selected_skill_id",
      "intermediate_operation",
      "final_answer"
    ],
    "skill_assessments": "one {skill_id, applicable} object per presented candidate, in presentation order",
    "selected_skill_id": "one presented candidate ID or the frozen sentinel none",
    "intermediate_operation": "non-empty short operation label, not chain-of-thought",
    "final_answer": "non-empty short answer"
  },
  "analysis_plan": {
    "primary_specificity_metrics": [
      "contextual_single_correct_selection_rate",
      "irrelevant_single_rejection_rate",
      "dual_correct_selection_rate",
      "dual_wrong_selection_rate",
      "dual_order_effect_absolute_difference"
    ],
    "outcome_mediation_metrics": [
      "contextual_vs_irrelevant_operation_change_rate",
      "contextual_vs_irrelevant_normalized_answer_change_rate",
      "contextual_alias_net_wins_over_irrelevant",
      "contextual_alias_net_loss_vs_cold"
    ],
    "positive_gate": {
      "contextual_single_correct_selection_rate_at_least": 0.75,
      "irrelevant_single_rejection_rate_at_least": 0.75,
      "each_family_irrelevant_single_rejection_rate_at_least": 0.65,
      "dual_correct_selection_rate_at_least": 0.65,
      "dual_wrong_selection_rate_at_most": 0.10,
      "dual_order_effect_absolute_difference_at_most": 0.15,
      "contextual_vs_irrelevant_operation_change_rate_at_least": 0.30,
      "contextual_vs_irrelevant_normalized_answer_change_rate_at_least": 0.10,
      "contextual_alias_net_wins_over_irrelevant_at_least": 2,
      "contextual_alias_net_loss_vs_cold_at_most": 1
    },
    "negative_gate": {
      "contextual_single_correct_selection_rate_below": 0.50,
      "or_irrelevant_single_rejection_rate_below": 0.50,
      "or_dual_wrong_selection_rate_at_least_dual_correct_selection_rate": true
    },
    "inconclusive_gate": "Any completed result satisfying neither the positive nor negative gate.",
    "stop_rule": "Do not cross-domain scale unless the full positive specificity-and-mediation gate passes. If specificity passes without mediation, redesign task capability and answer sensitivity before further execution.",
    "family_reporting_required": true,
    "no_posthoc_regating": true
  },
  "future_execution_proposal": {
